# ──────────────────────────────────────────────────
# NexusHardware Backend — Variables de Entorno
# Copiar este archivo como .env y completar los valores
# NUNCA subir .env al repositorio Git
# ──────────────────────────────────────────────────

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/nexushardware_db"

# JWT
JWT_SECRET=cambia_esto_por_una_clave_secreta_segura
JWT_EXPIRES_IN=7d

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:3000
